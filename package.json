{
  "name": "rbtflow",
  "displayName": "RBTFlow",
  "description": "Native Review Board submission, comments, review inbox and diffs in VS Code.",
  "version": "0.4.0",
  "publisher": "ganjinbo",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cossoledad/RBTFlow.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./build/extension/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "RBTools executes repository Python configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "RBTFlow requires local Git and RBTools in the workspace extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "rbtflow.openReview",
        "title": "RBTFlow: Open RBTFlow",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "rbtflow.chooseRepository",
        "title": "RBTFlow: Choose Repository",
        "icon": "$(repo)"
      },
      {
        "command": "rbtflow.settings",
        "title": "RBTFlow: Repository Settings",
        "icon": "$(gear)"
      },
      {
        "command": "rbtflow.preview",
        "title": "RBTFlow: Preview Changes",
        "icon": "$(diff)"
      },
      {
        "command": "rbtflow.createDraft",
        "title": "RBTFlow: Create Draft",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rbtflow.newReview",
        "title": "RBTFlow: New Submission",
        "icon": "$(add)"
      },
      {
        "command": "rbtflow.openById",
        "title": "RBTFlow: Open Request by ID",
        "icon": "$(go-to-file)"
      },
      {
        "command": "rbtflow.myReviews",
        "title": "RBTFlow: My Requests",
        "icon": "$(account)"
      },
      {
        "command": "rbtflow.refreshReview",
        "title": "RBTFlow: Refresh Request",
        "icon": "$(refresh)"
      },
      {
        "command": "rbtflow.publishRequest",
        "title": "RBTFlow: Publish Request",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "rbtflow.editRequest",
        "title": "RBTFlow: Edit Request Details",
        "icon": "$(edit)"
      },
      {
        "command": "rbtflow.updateDiff",
        "title": "RBTFlow: Update Request Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "rbtflow.openDescription",
        "title": "RBTFlow: View Description",
        "icon": "$(note)"
      },
      {
        "command": "rbtflow.openUrl",
        "title": "RBTFlow: Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "rbtflow.refresh",
        "title": "RBTFlow: Refresh Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "rbtflow.showLog",
        "title": "RBTFlow: Show Output",
        "icon": "$(output)"
      },
      {
        "command": "rbtflow.cancel",
        "title": "RBTFlow: Cancel",
        "icon": "$(close)"
      },
      {
        "command": "rbtflow.recover",
        "title": "RBTFlow: Check Server",
        "icon": "$(sync)"
      },
      {
        "command": "rbtflow.openChange",
        "title": "RBTFlow: Open Diff",
        "icon": "$(diff)"
      },
      {
        "command": "rbtflow.showPatch",
        "title": "RBTFlow: View Raw Diff",
        "icon": "$(code)"
      },
      {
        "command": "rbtflow.showTree",
        "title": "RBTFlow: Show as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "rbtflow.showList",
        "title": "RBTFlow: Show as List",
        "icon": "$(list-flat)"
      },
      {
        "command": "rbtflow.setToken",
        "title": "RBTFlow: Set API Token",
        "icon": "$(key)"
      },
      {
        "command": "rbtflow.run",
        "title": "RBTFlow: Run Action"
      },
      {
        "command": "rbtflow.addComment",
        "title": "Add to Review",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "rbtflow.removeComment",
        "title": "Remove Local Comment",
        "icon": "$(trash)"
      },
      {
        "command": "rbtflow.clearRecovery",
        "title": "RBTFlow: Clear Recovery Record",
        "icon": "$(clear-all)"
      },
      {
        "command": "rbtflow.showDiscussion",
        "title": "RBTFlow: View All Comments",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "rbtflow.refreshDiscussion",
        "title": "RBTFlow: Refresh Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "rbtflow.openCommentDiff",
        "title": "RBTFlow: Open Comment in Diff",
        "icon": "$(go-to-file)"
      },
      {
        "command": "rbtflow.refreshInbox",
        "title": "RBTFlow: Refresh Inbox",
        "icon": "$(refresh)"
      },
      {
        "command": "rbtflow.openInboxRequest",
        "title": "RBTFlow: Open Inbox Request",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "rbtflow.markInboxRead",
        "title": "RBTFlow: Mark as Read",
        "icon": "$(mail-read)"
      },
      {
        "command": "rbtflow.markInboxUnread",
        "title": "RBTFlow: Mark as Unread",
        "icon": "$(mail)"
      },
      {
        "command": "rbtflow.markAllInboxRead",
        "title": "RBTFlow: Mark All as Read",
        "icon": "$(check-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rbtflow",
          "title": "RBTFlow",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rbtflow": [
        {
          "id": "rbtflow.submit",
          "name": "Submit",
          "initialSize": 160
        },
        {
          "id": "rbtflow.inbox",
          "name": "Inbox",
          "initialSize": 180
        },
        {
          "id": "rbtflow.review",
          "name": "Review",
          "initialSize": 220
        },
        {
          "id": "rbtflow.changes",
          "name": "Changes",
          "initialSize": 280
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rbtflow.submit",
        "contents": "Open a Git folder."
      },
      {
        "view": "rbtflow.review",
        "contents": "[Open request](command:rbtflow.openById)\n[My requests](command:rbtflow.myReviews)"
      },
      {
        "view": "rbtflow.changes",
        "contents": "Preview changes or select a review request."
      },
      {
        "view": "rbtflow.inbox",
        "contents": "No assigned requests.\n[Refresh inbox](command:rbtflow.refreshInbox)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rbtflow.chooseRepository",
          "when": "view == rbtflow.submit",
          "group": "navigation@1"
        },
        {
          "command": "rbtflow.settings",
          "when": "view == rbtflow.submit",
          "group": "navigation@2"
        },
        {
          "command": "rbtflow.preview",
          "when": "view == rbtflow.submit && !rbtflow.busy",
          "group": "navigation@3"
        },
        {
          "command": "rbtflow.createDraft",
          "when": "view == rbtflow.submit && rbtflow.canCreate",
          "group": "navigation@4"
        },
        {
          "command": "rbtflow.newReview",
          "when": "view == rbtflow.submit",
          "group": "other@1"
        },
        {
          "command": "rbtflow.showLog",
          "when": "view == rbtflow.submit",
          "group": "other@2"
        },
        {
          "command": "rbtflow.cancel",
          "when": "view == rbtflow.submit && rbtflow.busy",
          "group": "navigation@5"
        },
        {
          "command": "rbtflow.openById",
          "when": "view == rbtflow.review",
          "group": "navigation@1"
        },
        {
          "command": "rbtflow.myReviews",
          "when": "view == rbtflow.review",
          "group": "navigation@2"
        },
        {
          "command": "rbtflow.refreshReview",
          "when": "view == rbtflow.review && rbtflow.hasReview && !rbtflow.busy",
          "group": "navigation@3"
        },
        {
          "command": "rbtflow.openUrl",
          "when": "view == rbtflow.review && rbtflow.hasReview",
          "group": "navigation@4"
        },
        {
          "command": "rbtflow.editRequest",
          "when": "view == rbtflow.review && rbtflow.canEditRequest",
          "group": "other@1"
        },
        {
          "command": "rbtflow.updateDiff",
          "when": "view == rbtflow.review && rbtflow.canEditRequest",
          "group": "other@2"
        },
        {
          "command": "rbtflow.openDescription",
          "when": "view == rbtflow.review && rbtflow.hasReview",
          "group": "other@3"
        },
        {
          "command": "rbtflow.recover",
          "when": "view == rbtflow.review",
          "group": "other@4"
        },
        {
          "command": "rbtflow.showLog",
          "when": "view == rbtflow.review",
          "group": "other@5"
        },
        {
          "command": "rbtflow.cancel",
          "when": "view == rbtflow.review && rbtflow.busy",
          "group": "navigation@5"
        },
        {
          "command": "rbtflow.showTree",
          "when": "view == rbtflow.changes && rbtflow.changesLayout == list",
          "group": "navigation@1"
        },
        {
          "command": "rbtflow.showList",
          "when": "view == rbtflow.changes && rbtflow.changesLayout == tree",
          "group": "navigation@1"
        },
        {
          "command": "rbtflow.showPatch",
          "when": "view == rbtflow.changes && rbtflow.hasComparison",
          "group": "navigation@2"
        },
        {
          "command": "rbtflow.clearRecovery",
          "when": "view == rbtflow.review && rbtflow.hasPending && !rbtflow.busy",
          "group": "other@6"
        },
        {
          "command": "rbtflow.refreshInbox",
          "when": "view == rbtflow.inbox",
          "group": "navigation@1"
        },
        {
          "command": "rbtflow.markAllInboxRead",
          "when": "view == rbtflow.inbox",
          "group": "navigation@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "rbtflow.addComment",
          "when": "commentController == rbtflow && commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "rbtflow.removeComment",
          "when": "commentController == rbtflow && commentThread =~ /^[0-9a-f-]{36}$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "rbtflow.run",
          "when": "false"
        },
        {
          "command": "rbtflow.openChange",
          "when": "false"
        },
        {
          "command": "rbtflow.addComment",
          "when": "false"
        },
        {
          "command": "rbtflow.removeComment",
          "when": "false"
        },
        {
          "command": "rbtflow.openUrl",
          "when": "false"
        },
        {
          "command": "rbtflow.clearRecovery",
          "when": "rbtflow.hasPending && !rbtflow.busy"
        },
        {
          "command": "rbtflow.openInboxRequest",
          "when": "false"
        },
        {
          "command": "rbtflow.markInboxRead",
          "when": "false"
        },
        {
          "command": "rbtflow.markInboxUnread",
          "when": "false"
        },
        {
          "command": "rbtflow.openCommentDiff",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "rbtflow.markInboxRead",
          "when": "view == rbtflow.inbox && viewItem == rbtflow.inboxUnread",
          "group": "inline@1"
        },
        {
          "command": "rbtflow.markInboxUnread",
          "when": "view == rbtflow.inbox && viewItem == rbtflow.inboxRead",
          "group": "inline@1"
        },
        {
          "command": "rbtflow.openCommentDiff",
          "when": "view == rbtflow.review && viewItem == rbtflow.diffComment",
          "group": "inline@1"
        },
        {
          "command": "rbtflow.refreshDiscussion",
          "when": "view == rbtflow.review && viewItem == rbtflow.discussion",
          "group": "inline@1"
        },
        {
          "command": "rbtflow.showDiscussion",
          "when": "view == rbtflow.review && viewItem == rbtflow.discussion",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "RBTFlow",
      "properties": {
        "rbtflow.rbtPath": {
          "type": "string",
          "default": "rbt",
          "scope": "machine-overridable",
          "description": "RBTools executable on the machine running this workspace. No shell arguments."
        },
        "rbtflow.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Review Board URL. Empty uses the existing RBTools configuration."
        },
        "rbtflow.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 1800,
          "description": "Timeout for each RBTools operation. Interrupted writes require checking server state."
        },
        "rbtflow.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh assigned reviews and notify about new requests or published content updates. The first sync is silent."
        },
        "rbtflow.notifications.pollIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "maximum": 3600,
          "description": "Seconds between inbox refreshes. Repository Settings can override this value."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/compile.cjs",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test build/extension/test/core.test.js build/extension/test/repository.test.js build/extension/test/collaboration-unit.test.js",
    "test:integration": "npm run compile && node --test --test-concurrency=1 build/extension/test/integration.test.js build/extension/test/review.test.js build/extension/test/request.test.js build/extension/test/collaboration.test.js",
    "test:host": "npm run compile && node scripts/test-host.cjs",
    "package": "vsce package --skip-license --out build/rbtflow-0.4.0.vsix",
    "vscode:prepublish": "npm run icon && npm run compile",
    "icon": "node scripts/icon.cjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "7.0.2"
  },
  "icon": "media/logo.png"
}
